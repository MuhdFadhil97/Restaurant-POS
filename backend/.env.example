# Postgres connection used by Prisma
DATABASE_URL="postgresql://pos:pos@localhost:5432/pos?schema=public"

# Server
PORT=4000
NODE_ENV=development

# JWT
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="8h"

# CORS
# Comma-separated list. Include your till PC's LAN IP so phones scanning the
# e-Invoice QR (see frontend VITE_PUBLIC_URL) can reach the API too.
CORS_ORIGIN="http://localhost:5173"

# Thermal printing (optional). PUBLIC_APP_URL = the frontend VITE_PUBLIC_URL,
# used to print the e-Invoice QR on receipts; APP_TIMEZONE for printed times.
# PUBLIC_APP_URL="http://192.168.1.10:5173"
# APP_TIMEZONE="Asia/Kuala_Lumpur"

# CRM campaign email delivery (optional). Without SMTP_HOST set, campaign
# sends are only logged to the console instead of actually delivered — see
# backend/src/lib/notifications/emailProvider.ts. If port 587 (STARTTLS)
# times out on your network, try 465 (implicit TLS) instead — some networks
# block outbound 587.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=465
# SMTP_USER="you@gmail.com"
# SMTP_PASS="your-16-char-app-password"
# SMTP_FROM_EMAIL="you@gmail.com"
# SMTP_FROM_NAME="Restaurant POS"

# License (see backend/docs/LICENSING.md). Leave both unset in local
# development — the app runs unrestricted automatically whenever NODE_ENV
# isn't "production". Required in production or the API runs restricted
# (read-only) until a valid license is set.
LICENSE_PUBLIC_KEY=""
LICENSE_KEY=""

