generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  MANAGER
  CASHIER
  KITCHEN
  SYSTEM // sentinel used by automated flows (e.g. QR self-order); never assignable via the Users UI
}

enum MovementType {
  RESTOCK
  WASTAGE
  CORRECTION
  SALE
  REFUND
  TRANSFER_OUT
  TRANSFER_IN
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  NOT_AVAILABLE
}

enum TransactionStatus {
  HELD // parked, no table (retail "hold" flow)
  OPEN // F&B: attached to a table, still accumulating items
  COMPLETED
  VOIDED
  REFUNDED
}

enum TransactionOrigin {
  POS // created by a staff member
  QR // created by a customer via table QR self-order
  DELIVERY // created from a delivery platform webhook
}

enum DeliveryProvider {
  GRAB
  FOODPANDA
  DOORDASH
  CUSTOM // generic webhook, e.g. a self-built ordering site or an aggregator without a dedicated adapter
}

enum DeliveryOrderStatus {
  PENDING // just received, awaiting accept/reject
  ACCEPTED // kitchen is preparing it
  REJECTED
  READY // prepared, awaiting courier pickup
  PICKED_UP // courier collected it — terminal state
  CANCELLED // cancelled after acceptance (e.g. by the platform/customer)
}

enum AccountingExportFormat {
  QUICKBOOKS_CSV
  XERO_CSV
  GENERIC_CSV
}

enum AccountingExportStatus {
  COMPLETED
  FAILED
}

enum CampaignChannel {
  EMAIL
  SMS // declared for forward-compat; no adapter yet, same convention as DeliveryProvider's unimplemented values
  PUSH
}

enum CampaignTriggerType {
  MANUAL
  SCHEDULED // declared for forward-compat; no scheduler exists yet, sending is rejected for non-MANUAL campaigns
  EVENT_BIRTHDAY
  EVENT_WINBACK
}

enum CampaignStatus {
  DRAFT
  SENDING
  COMPLETED
  FAILED
}

enum CampaignSendStatus {
  SENT
  FAILED
  SKIPPED_NO_CONSENT
  SKIPPED_NO_CONTACT
}

enum SegmentRuleType {
  ALL_CUSTOMERS
  NO_VISIT_SINCE_DAYS
  BIRTHDAY_WITHIN_DAYS
  TOTAL_SPEND_ABOVE
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ReservationSource {
  STAFF
  ONLINE
  PHONE
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum DiscountScope {
  LINE
  ORDER
}

enum PaymentMethod {
  CASH
  CARD
  EWALLET
  GIFT_CARD
  LOYALTY_POINTS
  ONLINE // settled by a delivery/online-ordering platform, not collected at the till
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CustomerSource {
  WALK_IN
  SOCIAL_MEDIA
  REFERRAL
  THIRD_PARTY
  ONLINE
}

enum PrepStatus {
  QUEUED
  PREPARING
  READY
  SERVED
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum StockTransferStatus {
  PENDING
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum StockTakeStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum EInvoiceStatus {
  NOT_APPLICABLE // outlet has no e-Invoice fields configured, or txn never reached COMPLETED
  GENERATED // simulated stand-in for LHDN's VALIDATED state
  CANCELLED // txn was voided/refunded after an e-Invoice had been generated
}

// ─────────────────────────────────────────────────────────────────────────
// Outlets & Users
// ─────────────────────────────────────────────────────────────────────────

model Outlet {
  id       Int     @id @default(autoincrement())
  name     String
  address  String?
  phone    String?
  isActive Boolean @default(true)

  // Malaysia LHDN e-Invoice (MyInvois) business registration details, used to
  // generate simulated e-Invoices at checkout. All optional: an outlet with
  // no TIN configured simply never generates e-Invoices (existing receipt
  // behavior is unchanged for outlets that don't opt in).
  einvoiceTin      String? @map("einvoice_tin")
  einvoiceBrn      String? @map("einvoice_brn")
  einvoiceMsicCode String? @map("einvoice_msic_code")
  einvoiceSstNo    String? @map("einvoice_sst_no")

  // Receipt template settings (business name reuses `name` above).
  receiptLogoUrl String? @map("receipt_logo_url")
  receiptFooter  String? @map("receipt_footer")

  // Loyalty program settings (points earned per currency unit spent, and
  // the currency value of one point when redeemed).
  loyaltyEarnRate   Decimal @default(1) @map("loyalty_earn_rate") @db.Decimal(6, 2)
  loyaltyRedeemRate Decimal @default(0.01) @map("loyalty_redeem_rate") @db.Decimal(6, 4)

  // Malaysian-standard F&B service charge, applied at checkout on top of the
  // discounted subtotal and, in turn, itself subject to tax (see
  // calculateTotals in transactions/calculations.ts).
  serviceChargeEnabled Boolean @default(true) @map("service_charge_enabled")
  serviceChargeRate    Decimal @default(10) @map("service_charge_rate") @db.Decimal(5, 2)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  userAccess           UserOutlet[]
  productStocks        ProductStock[]
  inventoryMovements   InventoryMovement[]
  tables               Table[]
  transactions         Transaction[]
  reservations         Reservation[]
  taxRates             TaxRate[]
  cashSessions         CashSession[]
  auditLogs            AuditLog[]
  kitchenStations      KitchenStation[]
  purchaseOrders       PurchaseOrder[]
  goodsReceivedNotes   GoodsReceivedNote[]
  transfersOut         StockTransfer[]       @relation("TransferFromOutlet")
  transfersIn          StockTransfer[]       @relation("TransferToOutlet")
  stockTakes           StockTake[]
  staffShiftTemplates  StaffShiftTemplate[]
  staffShiftSchedules  StaffShiftSchedule[]
  staffAttendance      StaffAttendance[]
  terminals            Terminal[]
  printers             Printer[]
  printBridges         PrintBridge[]
  printJobs            PrintJob[]
  deliveryPlatforms    DeliveryPlatform[]
  deliveryOrders       DeliveryOrder[]
  accountingExportRuns AccountingExportRun[]

  @@map("outlets")
}

model User {
  id           Int     @id @default(autoincrement())
  email        String  @unique
  username     String  @unique
  passwordHash String  @map("password_hash")
  name         String
  role         Role
  isActive     Boolean @default(true) @map("is_active")
  moduleAccessCustomized Boolean @default(false) @map("module_access_customized")

  // Login security (see [[verify-ui-by-driving-it]]-style incremental hardening).
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  outletAccess            UserOutlet[]
  moduleAccess            UserModuleAccess[]
  createdPrintJobs        PrintJob[]
  cashierTransactions     Transaction[]         @relation("CashierTransactions")
  voidedTransactions      Transaction[]         @relation("VoidedByUser")
  approvedTransactions    Transaction[]         @relation("ApprovedByUser")
  inventoryMovements      InventoryMovement[]
  cashSessions            CashSession[]
  auditLogs               AuditLog[]
  purchaseOrdersCreated   PurchaseOrder[]       @relation("PurchaseOrderCreatedBy")
  purchaseOrdersApproved  PurchaseOrder[]       @relation("PurchaseOrderApprovedBy")
  goodsReceivedNotes      GoodsReceivedNote[]
  stockTransfersRequested StockTransfer[]
  stockTakesStarted       StockTake[]           @relation("StockTakeStartedBy")
  stockTakesCompleted     StockTake[]           @relation("StockTakeCompletedBy")
  staffShiftSchedules     StaffShiftSchedule[]  @relation("StaffShiftScheduleUser")
  createdShiftSchedules   StaffShiftSchedule[]  @relation("StaffShiftScheduleCreatedBy")
  staffAttendance         StaffAttendance[]
  accountingExportRuns    AccountingExportRun[]
  customerSegmentsCreated CustomerSegment[]
  campaignsCreated        Campaign[]

  @@map("users")
}

// Many-to-many: which outlets a user can operate in. Cashiers usually get
// exactly one row; managers/admins may be granted several.
model UserOutlet {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  outletId  Int      @map("outlet_id")
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  outlet Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([userId, outletId])
  @@map("user_outlets")
}

// Per-user module access overrides. Existence of a row = access granted.
// A user with zero rows has never been customized and falls back to their
// role's default modules (see backend/src/lib/modules.ts).
model UserModuleAccess {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  moduleKey String   @map("module_key")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleKey])
  @@map("user_module_access")
}

// ─────────────────────────────────────────────────────────────────────────
// Product Catalog (shared across outlets) & Inventory (per outlet)
// ─────────────────────────────────────────────────────────────────────────

model ProductCategory {
  id        Int       @id @default(autoincrement())
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Which ledger account this category's sales post to in an accounting
  // export (see modules/accountingExport). Free text so it matches
  // whatever chart of accounts the outlet's bookkeeper already uses;
  // falls back to the category name when unset.
  accountingCategory String? @map("accounting_category")

  products Product[]

  @@map("product_categories")
}

model Product {
  id                Int     @id @default(autoincrement())
  sku               String  @unique
  name              String
  categoryId        Int?    @map("category_id")
  unitPrice         Decimal @map("unit_price") @db.Decimal(12, 2)
  costPrice         Decimal @map("cost_price") @db.Decimal(12, 2)
  taxRateId         Int?    @map("tax_rate_id")
  unitOfMeasure     String  @map("unit_of_measure")
  imageUrl          String? @map("image_url")
  lowStockThreshold Int     @default(0) @map("low_stock_threshold")
  isActive          Boolean @default(true) @map("is_active")

  // F&B order routing: which prep station (e.g. Kitchen, Bar) makes this.
  stationId Int? @map("station_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  category ProductCategory? @relation(fields: [categoryId], references: [id])
  taxRate  TaxRate?         @relation(fields: [taxRateId], references: [id])
  station  KitchenStation?  @relation(fields: [stationId], references: [id])

  variants               ProductVariant[]
  stocks                 ProductStock[]
  inventoryMovements     InventoryMovement[]
  transactionItems       TransactionItem[]
  purchaseOrderItems     PurchaseOrderItem[]
  stockTransferItems     StockTransferItem[]
  goodsReceivedNoteItems GoodsReceivedNoteItem[]
  stockTakeItems         StockTakeItem[]
  discounts              Discount[]
  supplierProducts       SupplierProduct[]

  @@map("products")
}

model ProductVariant {
  id              Int       @id @default(autoincrement())
  productId       Int       @map("product_id")
  name            String // e.g. "Size", "Flavor"
  value           String // e.g. "Large", "Chocolate"
  skuSuffix       String?   @map("sku_suffix")
  priceAdjustment Decimal   @default(0) @map("price_adjustment") @db.Decimal(12, 2)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  stocks                 ProductStock[]
  inventoryMovements     InventoryMovement[]
  transactionItems       TransactionItem[]
  purchaseOrderItems     PurchaseOrderItem[]
  stockTransferItems     StockTransferItem[]
  goodsReceivedNoteItems GoodsReceivedNoteItem[]
  stockTakeItems         StockTakeItem[]
  supplierProducts       SupplierProduct[]

  @@map("product_variants")
}

// Current stock level per outlet (and optionally per variant).
model ProductStock {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  variantId Int?     @map("variant_id")
  outletId  Int      @map("outlet_id")
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  outlet  Outlet          @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([productId, variantId, outletId])
  @@map("product_stocks")
}

// Audit trail of every stock change, per outlet.
model InventoryMovement {
  id                Int          @id @default(autoincrement())
  outletId          Int          @map("outlet_id")
  productId         Int          @map("product_id")
  variantId         Int?         @map("variant_id")
  type              MovementType
  quantityChange    Int          @map("quantity_change") // positive = in, negative = out
  reason            String?
  performedByUserId Int          @map("performed_by_user_id")
  createdAt         DateTime     @default(now()) @map("created_at")

  outlet      Outlet          @relation(fields: [outletId], references: [id])
  product     Product         @relation(fields: [productId], references: [id])
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  performedBy User            @relation(fields: [performedByUserId], references: [id])

  @@map("inventory_movements")
}

// ─────────────────────────────────────────────────────────────────────────
// F&B Tables & Kitchen Order Routing
// ─────────────────────────────────────────────────────────────────────────

enum TableShape {
  ROUND
  RECTANGLE
}

model Table {
  id       Int         @id @default(autoincrement())
  outletId Int         @map("outlet_id")
  name     String
  capacity Int         @default(2)
  status   TableStatus @default(AVAILABLE)

  // Customer QR self-order. Null until staff generate one from Settings;
  // regenerating overwrites it, immediately invalidating the old QR.
  qrToken          String?   @unique @map("qr_token")
  qrTokenRotatedAt DateTime? @map("qr_token_rotated_at")

  // Floor plan layout — nullable; null means "not yet positioned" (POS
  // falls back to the plain table strip until an outlet has a saved layout).
  posX   Int?        @map("pos_x")
  posY   Int?        @map("pos_y")
  shape  TableShape? @map("shape")
  width  Int?        @map("width")
  height Int?        @map("height")

  // Reservation metadata — only meaningful while status = RESERVED; all
  // four fields are cleared together whenever status changes away from
  // RESERVED (enforced in service.ts, not just the UI).
  reservedFor       String?   @map("reserved_for")
  reservedAt        DateTime? @map("reserved_at")
  reservedPartySize Int?      @map("reserved_party_size")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  outlet       Outlet        @relation(fields: [outletId], references: [id])
  transactions Transaction[]
  reservations Reservation[]

  @@map("tables")
}

model Reservation {
  id                 Int               @id @default(autoincrement())
  outletId           Int               @map("outlet_id")
  tableId            Int?              @map("table_id") // nullable until staff assign a table
  customerId         Int?              @map("customer_id")
  customerName       String            @map("customer_name")
  phone              String?
  partySize          Int               @map("party_size")
  reservedFor        DateTime          @map("reserved_for")
  durationMinutes    Int               @default(90) @map("duration_minutes")
  status             ReservationStatus @default(PENDING)
  source             ReservationSource @default(STAFF)
  // Deposits are collected in person at seating and recorded here as a plain
  // amount — Payment rows require an existing Transaction, which doesn't
  // exist yet at booking time, so deposits aren't backed by a Payment.
  depositAmount      Decimal?          @map("deposit_amount") @db.Decimal(12, 2)
  depositCollectedAt DateTime?         @map("deposit_collected_at")
  notes              String?
  transactionId      Int?              @unique @map("transaction_id") // set once seated & a tab is opened
  cancelledReason    String?           @map("cancelled_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  outlet      Outlet       @relation(fields: [outletId], references: [id])
  table       Table?       @relation(fields: [tableId], references: [id])
  customer    Customer?    @relation(fields: [customerId], references: [id])
  transaction Transaction? @relation(fields: [transactionId], references: [id])

  @@index([outletId, reservedFor])
  @@map("reservations")
}

// Credentials + settings for one delivery-platform connection at one outlet
// (an outlet can run several, e.g. Grab and a CUSTOM webhook side by side).
// apiKey/webhookSecret are encrypted at rest (see lib/crypto.ts) — unlike
// PrintBridge's token, these must be recoverable in plaintext to sign
// outgoing calls and verify incoming webhook signatures, so they're
// encrypted rather than hashed.
model DeliveryPlatform {
  id                     Int              @id @default(autoincrement())
  outletId               Int              @map("outlet_id")
  provider               DeliveryProvider
  name                   String // display name, e.g. "Grab (Main Outlet)"
  apiKeyEncrypted        String?          @map("api_key_encrypted")
  webhookSecretEncrypted String?          @map("webhook_secret_encrypted")
  autoAccept             Boolean          @default(false) @map("auto_accept")
  isActive               Boolean          @default(true) @map("is_active")
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")
  deletedAt              DateTime?        @map("deleted_at")

  outlet         Outlet          @relation(fields: [outletId], references: [id])
  deliveryOrders DeliveryOrder[]

  @@map("delivery_platforms")
}

// One incoming order from a delivery platform. transactionId is set once
// accepted (checkout/finalize reused, origin=DELIVERY) — PENDING orders have
// no Transaction yet, mirroring Reservation's "not booked until confirmed"
// shape. @@unique([platformId, externalOrderId]) makes webhook delivery
// idempotent: replays of the same platform order upsert instead of duplicating.
model DeliveryOrder {
  id               Int                 @id @default(autoincrement())
  outletId         Int                 @map("outlet_id")
  platformId       Int                 @map("platform_id")
  transactionId    Int?                @unique @map("transaction_id")
  externalOrderId  String              @map("external_order_id")
  externalStatus   String?             @map("external_status") // raw platform status string, informational only
  status           DeliveryOrderStatus @default(PENDING)
  rawPayload       Json                @map("raw_payload")
  customerName     String?             @map("customer_name")
  customerPhone    String?             @map("customer_phone")
  deliveryAddress  String?             @map("delivery_address")
  courierName      String?             @map("courier_name")
  courierPhone     String?             @map("courier_phone")
  commissionAmount Decimal?            @map("commission_amount") @db.Decimal(12, 2)
  rejectedReason   String?             @map("rejected_reason")
  acceptedAt       DateTime?           @map("accepted_at")
  readyAt          DateTime?           @map("ready_at")
  pickedUpAt       DateTime?           @map("picked_up_at")
  syncedAt         DateTime?           @map("synced_at")
  // Staff-triggered, only from a terminal state (PICKED_UP/REJECTED) — hides
  // it from the default Kanban view without deleting the row, since it's a
  // financial record tied to a receipt/e-invoice (same "never hard-delete"
  // convention as Transaction/Reservation elsewhere in this schema).
  archivedAt       DateTime?           @map("archived_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  outlet      Outlet           @relation(fields: [outletId], references: [id])
  platform    DeliveryPlatform @relation(fields: [platformId], references: [id])
  transaction Transaction?     @relation(fields: [transactionId], references: [id])

  @@unique([platformId, externalOrderId])
  @@index([outletId, status])
  @@map("delivery_orders")
}

// A prep station in the kitchen/bar that a Kitchen Display screen filters
// to (e.g. "Kitchen", "Bar", "Dessert").
model KitchenStation {
  id        Int       @id @default(autoincrement())
  outletId  Int       @map("outlet_id")
  name      String
  // Kitchen/bar ticket printer for this station (optional; a station with no
  // printer is KDS-only).
  printerId Int?      @map("printer_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  outlet   Outlet    @relation(fields: [outletId], references: [id])
  printer  Printer?  @relation(fields: [printerId], references: [id])
  products Product[]

  @@map("kitchen_stations")
}

// ─────────────────────────────────────────────────────────────────────────
// Customers
// ─────────────────────────────────────────────────────────────────────────

model Customer {
  id               Int             @id @default(autoincrement())
  name             String
  identificationNo String?         @map("identification_no")
  dateOfBirth      DateTime?       @map("date_of_birth") @db.Date
  phone            String?
  email            String?
  address          String?
  source           CustomerSource? @map("source")

  // Loyalty points balance, accrued/redeemed on completed transactions.
  pointsBalance Int @default(0) @map("points_balance")

  // PDPA marketing consent — gates every CampaignSend (see modules/campaigns).
  // Explicit opt-in only; no send is attempted for a customer without it.
  marketingConsent   Boolean   @default(false) @map("marketing_consent")
  marketingConsentAt DateTime? @map("marketing_consent_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  transactions  Transaction[]
  reservations  Reservation[]
  campaignSends CampaignSend[]

  @@map("customers")
}

// ─────────────────────────────────────────────────────────────────────────
// CRM / Marketing Automation
// ─────────────────────────────────────────────────────────────────────────

// Structured rule + single numeric threshold (not a free-form JSON rule
// engine) — every rule type is mechanically evaluable by one Prisma query
// (see modules/segments/service.ts evaluateSegment), and the frontend stays
// a dropdown + one number input rather than a JSON editor.
model CustomerSegment {
  id       Int             @id @default(autoincrement())
  name     String
  ruleType SegmentRuleType @map("rule_type")

  // Meaning depends on ruleType: days for NO_VISIT_SINCE_DAYS /
  // BIRTHDAY_WITHIN_DAYS, a spend threshold for TOTAL_SPEND_ABOVE, unused
  // (null) for ALL_CUSTOMERS.
  ruleValue Int? @map("rule_value")

  createdByUserId Int @map("created_by_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  createdBy User       @relation(fields: [createdByUserId], references: [id])
  campaigns Campaign[]

  @@map("customer_segments")
}

model Campaign {
  id          Int                 @id @default(autoincrement())
  name        String
  segmentId   Int                 @map("segment_id")
  channel     CampaignChannel     @default(EMAIL)
  triggerType CampaignTriggerType @default(MANUAL) @map("trigger_type")
  discountId  Int?                @map("discount_id")

  subject String
  // Plain text/HTML with a `{{customerName}}` placeholder substituted at
  // send time — no templating engine, matches the receipt template's
  // plain-string approach.
  body    String

  status CampaignStatus @default(DRAFT)
  sentAt DateTime?      @map("sent_at")

  createdByUserId Int @map("created_by_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  segment   CustomerSegment @relation(fields: [segmentId], references: [id])
  discount  Discount?       @relation(fields: [discountId], references: [id])
  createdBy User            @relation(fields: [createdByUserId], references: [id])

  sends CampaignSend[]

  @@map("campaigns")
}

// One row per recipient, snapshotted when the campaign is sent — both the
// audit trail and the per-recipient status the UI shows.
model CampaignSend {
  id           Int                @id @default(autoincrement())
  campaignId   Int                @map("campaign_id")
  customerId   Int                @map("customer_id")
  status       CampaignSendStatus
  errorMessage String?            @map("error_message")
  sentAt       DateTime?          @map("sent_at")
  createdAt    DateTime           @default(now()) @map("created_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id])

  @@map("campaign_sends")
}

// ─────────────────────────────────────────────────────────────────────────
// Discounts, Promotions & Tax
// ─────────────────────────────────────────────────────────────────────────

model Discount {
  id       Int           @id @default(autoincrement())
  name     String
  type     DiscountType
  scope    DiscountScope
  value    Decimal       @db.Decimal(12, 2) // percentage (0-100) or fixed amount
  code     String?       @unique
  isActive Boolean       @default(true) @map("is_active")

  // Promotion eligibility rules (all optional; null = no constraint).
  minSpend   Decimal?  @map("min_spend") @db.Decimal(12, 2)
  startDate  DateTime? @map("start_date")
  endDate    DateTime? @map("end_date")
  usageLimit Int?      @map("usage_limit")
  usageCount Int       @default(0) @map("usage_count")
  productId  Int?      @map("product_id")
  categoryId Int?      @map("category_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product? @relation(fields: [productId], references: [id])

  transactionItems TransactionItem[]
  orderDiscountOn  Transaction[]     @relation("OrderDiscount")
  campaigns        Campaign[]

  @@map("discounts")
}

model TaxRate {
  id        Int      @id @default(autoincrement())
  outletId  Int      @map("outlet_id")
  name      String
  rate      Decimal  @db.Decimal(5, 2) // percentage, e.g. 6.00
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  outlet             Outlet              @relation(fields: [outletId], references: [id])
  products           Product[]
  purchaseOrderItems PurchaseOrderItem[]

  @@map("tax_rates")
}

// ─────────────────────────────────────────────────────────────────────────
// Gift Cards
// ─────────────────────────────────────────────────────────────────────────

model GiftCard {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  balance   Decimal   @db.Decimal(12, 2)
  isActive  Boolean   @default(true) @map("is_active")
  issuedAt  DateTime  @default(now()) @map("issued_at")
  expiresAt DateTime? @map("expires_at")

  payments Payment[]

  @@map("gift_cards")
}

// ─────────────────────────────────────────────────────────────────────────
// Transactions (checkout, hold/resume, F&B open tabs, void/refund)
// ─────────────────────────────────────────────────────────────────────────

model Transaction {
  id         Int               @id @default(autoincrement())
  outletId   Int               @map("outlet_id")
  tableId    Int?              @map("table_id") // set for F&B dine-in
  customerId Int?              @map("customer_id")
  cashierId  Int               @map("cashier_id")
  status     TransactionStatus @default(OPEN)
  origin     TransactionOrigin @default(POS)

  // Assigned once, when the transaction first reaches COMPLETED. Format: RECYYYYMMDDXXXXXX.
  receiptNumber String? @unique @map("receipt_number")

  // Simulated LHDN MyInvois e-Invoice, assigned at COMPLETED (see
  // generateSimulatedEInvoice in transactions/einvoice.ts). uuid + longId
  // mirror exactly what a real MyInvois submission response returns, so a
  // later real-API integration only needs to swap the generator function —
  // these columns and everything downstream (Receipt QR) stay the same.
  einvoiceStatus      EInvoiceStatus @default(NOT_APPLICABLE) @map("einvoice_status")
  einvoiceUuid        String?        @unique @map("einvoice_uuid")
  einvoiceLongId      String?        @map("einvoice_long_id")
  einvoiceGeneratedAt DateTime?      @map("einvoice_generated_at")

  subtotal           Decimal @default(0) @db.Decimal(12, 2)
  discountTotal      Decimal @default(0) @map("discount_total") @db.Decimal(12, 2)
  orderDiscountId    Int?    @map("order_discount_id")
  serviceChargeTotal Decimal @default(0) @map("service_charge_total") @db.Decimal(12, 2)
  taxTotal           Decimal @default(0) @map("tax_total") @db.Decimal(12, 2)
  total              Decimal @default(0) @db.Decimal(12, 2)

  // Loyalty accrual/redemption recorded on the completed transaction.
  pointsEarned   Int @default(0) @map("points_earned")
  pointsRedeemed Int @default(0) @map("points_redeemed")

  notes String?

  voidReason       String?   @map("void_reason")
  voidedAt         DateTime? @map("voided_at")
  voidedByUserId   Int?      @map("voided_by_user_id")
  approvedByUserId Int?      @map("approved_by_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  outlet        Outlet    @relation(fields: [outletId], references: [id])
  table         Table?    @relation(fields: [tableId], references: [id])
  customer      Customer? @relation(fields: [customerId], references: [id])
  cashier       User      @relation("CashierTransactions", fields: [cashierId], references: [id])
  voidedBy      User?     @relation("VoidedByUser", fields: [voidedByUserId], references: [id])
  approvedBy    User?     @relation("ApprovedByUser", fields: [approvedByUserId], references: [id])
  orderDiscount Discount? @relation("OrderDiscount", fields: [orderDiscountId], references: [id])

  items         TransactionItem[]
  payments      Payment[]
  printJobs     PrintJob[]
  reservation   Reservation?
  deliveryOrder DeliveryOrder?

  @@map("transactions")
}

// Backs the atomic per-day counter used to number receipts (RECYYYYMMDDXXXXXX).
// One row per calendar day; incremented with a single UPDATE so concurrent
// checkouts serialize on the row lock instead of racing on a read-then-write.
model ReceiptSequence {
  date       String @id @db.Char(8)
  lastNumber Int    @default(0) @map("last_number")

  @@map("receipt_sequences")
}

model TransactionItem {
  id             Int     @id @default(autoincrement())
  transactionId  Int     @map("transaction_id")
  productId      Int     @map("product_id")
  variantId      Int?    @map("variant_id")
  quantity       Int
  unitPrice      Decimal @map("unit_price") @db.Decimal(12, 2)
  discountId     Int?    @map("discount_id")
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @map("tax_amount") @db.Decimal(12, 2)
  lineTotal      Decimal @map("line_total") @db.Decimal(12, 2)

  // Kitchen Display order-routing status.
  prepStatus  PrepStatus @default(QUEUED) @map("prep_status")
  preparingAt DateTime?  @map("preparing_at")
  readyAt     DateTime?  @map("ready_at")
  servedAt    DateTime?  @map("served_at")

  // Set once the item has gone out on a kitchen ticket, so "Send to kitchen"
  // only prints items that haven't been printed yet.
  kitchenPrintedAt DateTime? @map("kitchen_printed_at")

  createdAt DateTime @default(now()) @map("created_at")

  transaction Transaction     @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product     Product         @relation(fields: [productId], references: [id])
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  discount    Discount?       @relation(fields: [discountId], references: [id])

  @@map("transaction_items")
}

model Payment {
  id            Int           @id @default(autoincrement())
  transactionId Int           @map("transaction_id")
  method        PaymentMethod
  amount        Decimal       @db.Decimal(12, 2)
  reference     String?
  remark        String?
  giftCardId    Int?          @map("gift_card_id")
  createdAt     DateTime      @default(now()) @map("created_at")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  giftCard    GiftCard?   @relation(fields: [giftCardId], references: [id])

  @@map("payments")
}

// ─────────────────────────────────────────────────────────────────────────
// Accounting / Finance Export
// ─────────────────────────────────────────────────────────────────────────

// One row per generated export "run" — no new source-of-truth data, it's a
// derived report file. Kept as a persisted record (rather than a stateless
// download like the generic Reports catalog) so a run's file can be
// re-downloaded later without regenerating it, and so staff have an audit
// trail of who exported what period in which format.
model AccountingExportRun {
  id       Int                    @id @default(autoincrement())
  outletId Int                    @map("outlet_id")
  format   AccountingExportFormat
  status   AccountingExportStatus @default(COMPLETED)

  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")

  // Relative path under the (non-public) accounting-exports upload dir;
  // null when status is FAILED.
  fileUrl      String? @map("file_url")
  rowCount     Int     @default(0) @map("row_count")
  errorMessage String? @map("error_message")

  requestedByUserId Int @map("requested_by_user_id")

  createdAt DateTime @default(now()) @map("created_at")

  outlet      Outlet @relation(fields: [outletId], references: [id])
  requestedBy User   @relation(fields: [requestedByUserId], references: [id])

  @@map("accounting_export_runs")
}

// ─────────────────────────────────────────────────────────────────────────
// Cash Sessions (shift open/close reconciliation)
// ─────────────────────────────────────────────────────────────────────────

model CashSession {
  id           Int               @id @default(autoincrement())
  outletId     Int               @map("outlet_id")
  userId       Int               @map("user_id")
  terminalId   Int?              @map("terminal_id")
  status       CashSessionStatus @default(OPEN)
  openingCash  Decimal           @map("opening_cash") @db.Decimal(12, 2)
  expectedCash Decimal?          @map("expected_cash") @db.Decimal(12, 2)
  actualCash   Decimal?          @map("actual_cash") @db.Decimal(12, 2)
  difference   Decimal?          @db.Decimal(12, 2)
  openedAt     DateTime          @default(now()) @map("opened_at")
  closedAt     DateTime?         @map("closed_at")

  outlet   Outlet    @relation(fields: [outletId], references: [id])
  user     User      @relation(fields: [userId], references: [id])
  terminal Terminal? @relation(fields: [terminalId], references: [id])

  @@map("cash_sessions")
}

enum AttendanceStatus {
  CLOCKED_IN
  ON_BREAK
  CLOCKED_OUT
}

// ─────────────────────────────────────────────────────────────────────────
// Staff Shift Management (attendance, breaks, roster — distinct from
// CashSession above, which is the till/cash-drawer "shift")
// ─────────────────────────────────────────────────────────────────────────

model StaffShiftTemplate {
  id           Int       @id @default(autoincrement())
  outletId     Int       @map("outlet_id")
  name         String
  startTime    String    @map("start_time") // "HH:mm", 24h
  endTime      String    @map("end_time") // "HH:mm"; endTime <= startTime means overnight (crosses midnight)
  breakMinutes Int       @default(30) @map("break_minutes")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at") // soft delete only — historical schedules/attendance keep resolving name/times

  outlet    Outlet               @relation(fields: [outletId], references: [id])
  schedules StaffShiftSchedule[]

  @@map("staff_shift_templates")
}

model StaffShiftSchedule {
  id              Int      @id @default(autoincrement())
  outletId        Int      @map("outlet_id")
  userId          Int      @map("user_id")
  shiftTemplateId Int      @map("shift_template_id")
  date            DateTime @map("date") @db.Date
  notes           String?
  createdByUserId Int      @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  outlet        Outlet             @relation(fields: [outletId], references: [id])
  user          User               @relation("StaffShiftScheduleUser", fields: [userId], references: [id])
  shiftTemplate StaffShiftTemplate @relation(fields: [shiftTemplateId], references: [id])
  createdBy     User               @relation("StaffShiftScheduleCreatedBy", fields: [createdByUserId], references: [id])
  attendance    StaffAttendance[]

  @@unique([userId, date, shiftTemplateId])
  @@index([outletId, date])
  @@index([userId, date])
  @@map("staff_shift_schedules")
}

model StaffAttendance {
  id                 Int              @id @default(autoincrement())
  outletId           Int              @map("outlet_id")
  userId             Int              @map("user_id")
  scheduleId         Int?             @map("schedule_id") // null = unscheduled/ad-hoc
  status             AttendanceStatus @default(CLOCKED_IN)
  clockInAt          DateTime         @map("clock_in_at")
  clockOutAt         DateTime?        @map("clock_out_at")
  totalWorkedMinutes Int?             @map("total_worked_minutes") // computed at clock-out
  totalBreakMinutes  Int?             @map("total_break_minutes") // computed at clock-out
  hasComplianceIssue Boolean          @default(false) @map("has_compliance_issue")
  complianceNotes    String?          @map("compliance_notes")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  outlet   Outlet              @relation(fields: [outletId], references: [id])
  user     User                @relation(fields: [userId], references: [id])
  schedule StaffShiftSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  breaks   StaffBreakRecord[]

  @@index([outletId, clockInAt])
  @@index([userId, clockInAt])
  @@map("staff_attendances")
}

model StaffBreakRecord {
  id           Int       @id @default(autoincrement())
  attendanceId Int       @map("attendance_id")
  breakStart   DateTime  @map("break_start")
  breakEnd     DateTime? @map("break_end")
  createdAt    DateTime  @default(now()) @map("created_at")

  attendance StaffAttendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  @@map("staff_break_records")
}

// ─────────────────────────────────────────────────────────────────────────
// Suppliers & Purchasing
// ─────────────────────────────────────────────────────────────────────────

model Supplier {
  id                    Int       @id @default(autoincrement())
  name                  String
  contactName           String?   @map("contact_name")
  email                 String?
  phone                 String?
  address               String?
  taxRegistrationNumber String?   @map("tax_registration_number")
  bankName              String?   @map("bank_name")
  bankAccountName       String?   @map("bank_account_name")
  bankAccountNumber     String?   @map("bank_account_number")
  paymentTerms          String?   @map("payment_terms")
  isActive              Boolean   @default(true) @map("is_active")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")

  purchaseOrders   PurchaseOrder[]
  supplierProducts SupplierProduct[]

  @@map("suppliers")
}

// A supplier's price catalog for a product: what they charge and how long
// delivery takes, prefilled onto new PO lines. Historical pricing (what was
// actually paid over time) is read from past PurchaseOrderItem rows instead
// of duplicated here — this table only holds the current quoted price.
model SupplierProduct {
  id           Int      @id @default(autoincrement())
  supplierId   Int      @map("supplier_id")
  productId    Int      @map("product_id")
  variantId    Int?     @map("variant_id")
  supplierSku  String?  @map("supplier_sku")
  unitCost     Decimal  @map("unit_cost") @db.Decimal(12, 2)
  leadTimeDays Int?     @map("lead_time_days")
  isPreferred  Boolean  @default(false) @map("is_preferred")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  supplier Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id])
  variant  ProductVariant? @relation(fields: [variantId], references: [id])

  @@unique([supplierId, productId, variantId])
  @@map("supplier_products")
}

// Allocates yearly-sequential, human-readable PO numbers (PO-{YYYY}-{00001}),
// atomically upserted the same way ReceiptSequence allocates receipt numbers.
model PurchaseOrderSequence {
  year       String @id @db.Char(4)
  lastNumber Int    @default(0) @map("last_number")

  @@map("purchase_order_sequences")
}

model PurchaseOrder {
  id                     Int                 @id @default(autoincrement())
  poNumber               String              @unique @map("po_number")
  outletId               Int                 @map("outlet_id")
  supplierId             Int                 @map("supplier_id")
  status                 PurchaseOrderStatus @default(DRAFT)
  createdByUserId        Int                 @map("created_by_user_id")
  subtotal               Decimal             @default(0) @db.Decimal(12, 2)
  discountTotal          Decimal             @default(0) @map("discount_total") @db.Decimal(12, 2)
  taxTotal               Decimal             @default(0) @map("tax_total") @db.Decimal(12, 2)
  total                  Decimal             @default(0) @db.Decimal(12, 2)
  submittedForApprovalAt DateTime?           @map("submitted_for_approval_at")
  approvedByUserId       Int?                @map("approved_by_user_id")
  approvedAt             DateTime?           @map("approved_at")
  rejectedAt             DateTime?           @map("rejected_at")
  rejectionReason        String?             @map("rejection_reason")
  orderedAt              DateTime?           @map("ordered_at")
  expectedAt             DateTime?           @map("expected_at")
  receivedAt             DateTime?           @map("received_at")
  notes                  String?
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")

  outlet             Outlet              @relation(fields: [outletId], references: [id])
  supplier           Supplier            @relation(fields: [supplierId], references: [id])
  createdBy          User                @relation("PurchaseOrderCreatedBy", fields: [createdByUserId], references: [id])
  approvedBy         User?               @relation("PurchaseOrderApprovedBy", fields: [approvedByUserId], references: [id])
  items              PurchaseOrderItem[]
  goodsReceivedNotes GoodsReceivedNote[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               Int     @id @default(autoincrement())
  purchaseOrderId  Int     @map("purchase_order_id")
  productId        Int     @map("product_id")
  variantId        Int?    @map("variant_id")
  quantityOrdered  Int     @map("quantity_ordered")
  quantityReceived Int     @default(0) @map("quantity_received")
  unitCost         Decimal @map("unit_cost") @db.Decimal(12, 2)
  taxRateId        Int?    @map("tax_rate_id")
  discountAmount   Decimal @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount        Decimal @default(0) @map("tax_amount") @db.Decimal(12, 2)
  lineTotal        Decimal @default(0) @map("line_total") @db.Decimal(12, 2)

  purchaseOrder          PurchaseOrder           @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product                Product                 @relation(fields: [productId], references: [id])
  variant                ProductVariant?         @relation(fields: [variantId], references: [id])
  taxRate                TaxRate?                @relation(fields: [taxRateId], references: [id])
  goodsReceivedNoteItems GoodsReceivedNoteItem[]

  @@map("purchase_order_items")
}

// A formal receiving document for one delivery against a purchase order — a
// PO can have several GRNs if the supplier delivers in partial shipments.
// Distinct from PurchaseOrderItem.quantityReceived (a running total): each
// GRN is the immutable record of what physically arrived in one delivery,
// including anything rejected (damaged/short) rather than accepted into stock.
model GoodsReceivedNote {
  id               Int      @id @default(autoincrement())
  purchaseOrderId  Int      @map("purchase_order_id")
  outletId         Int      @map("outlet_id")
  receivedByUserId Int      @map("received_by_user_id")
  receivedAt       DateTime @default(now()) @map("received_at")
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")

  purchaseOrder PurchaseOrder           @relation(fields: [purchaseOrderId], references: [id])
  outlet        Outlet                  @relation(fields: [outletId], references: [id])
  receivedBy    User                    @relation(fields: [receivedByUserId], references: [id])
  items         GoodsReceivedNoteItem[]

  @@map("goods_received_notes")
}

model GoodsReceivedNoteItem {
  id                  Int     @id @default(autoincrement())
  goodsReceivedNoteId Int     @map("goods_received_note_id")
  purchaseOrderItemId Int     @map("purchase_order_item_id")
  productId           Int     @map("product_id")
  variantId           Int?    @map("variant_id")
  quantityReceived    Int     @map("quantity_received") // accepted into stock
  quantityRejected    Int     @default(0) @map("quantity_rejected") // damaged/short — never added to stock
  rejectionReason     String? @map("rejection_reason")
  unitCost            Decimal @map("unit_cost") @db.Decimal(12, 2)

  goodsReceivedNote GoodsReceivedNote @relation(fields: [goodsReceivedNoteId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  product           Product           @relation(fields: [productId], references: [id])
  variant           ProductVariant?   @relation(fields: [variantId], references: [id])

  @@map("goods_received_note_items")
}

// ─────────────────────────────────────────────────────────────────────────
// Multi-Outlet Stock Transfers
// ─────────────────────────────────────────────────────────────────────────

model StockTransfer {
  id                Int                 @id @default(autoincrement())
  fromOutletId      Int                 @map("from_outlet_id")
  toOutletId        Int                 @map("to_outlet_id")
  status            StockTransferStatus @default(PENDING)
  requestedByUserId Int                 @map("requested_by_user_id")
  sentAt            DateTime?           @map("sent_at")
  receivedAt        DateTime?           @map("received_at")
  notes             String?
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  fromOutlet  Outlet              @relation("TransferFromOutlet", fields: [fromOutletId], references: [id])
  toOutlet    Outlet              @relation("TransferToOutlet", fields: [toOutletId], references: [id])
  requestedBy User                @relation(fields: [requestedByUserId], references: [id])
  items       StockTransferItem[]

  @@map("stock_transfers")
}

model StockTransferItem {
  id              Int  @id @default(autoincrement())
  stockTransferId Int  @map("stock_transfer_id")
  productId       Int  @map("product_id")
  variantId       Int? @map("variant_id")
  quantity        Int

  stockTransfer StockTransfer   @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  product       Product         @relation(fields: [productId], references: [id])
  variant       ProductVariant? @relation(fields: [variantId], references: [id])

  @@map("stock_transfer_items")
}

// ─────────────────────────────────────────────────────────────────────────
// Stock Take / Cycle Count — periodic physical count reconciled against
// system stock. Starting a stock take snapshots every ProductStock row at
// the outlet into StockTakeItem.systemQuantity; completing it writes any
// variance back to ProductStock as a CORRECTION InventoryMovement.
// ─────────────────────────────────────────────────────────────────────────

model StockTake {
  id                Int             @id @default(autoincrement())
  outletId          Int             @map("outlet_id")
  status            StockTakeStatus @default(IN_PROGRESS)
  startedByUserId   Int             @map("started_by_user_id")
  completedByUserId Int?            @map("completed_by_user_id")
  notes             String?
  startedAt         DateTime        @default(now()) @map("started_at")
  completedAt       DateTime?       @map("completed_at")

  outlet      Outlet          @relation(fields: [outletId], references: [id])
  startedBy   User            @relation("StockTakeStartedBy", fields: [startedByUserId], references: [id])
  completedBy User?           @relation("StockTakeCompletedBy", fields: [completedByUserId], references: [id])
  items       StockTakeItem[]

  @@map("stock_takes")
}

model StockTakeItem {
  id              Int     @id @default(autoincrement())
  stockTakeId     Int     @map("stock_take_id")
  productId       Int     @map("product_id")
  variantId       Int?    @map("variant_id")
  systemQuantity  Int     @map("system_quantity") // snapshot when the stock take started
  countedQuantity Int?    @map("counted_quantity") // null until a count is entered
  notes           String?

  stockTake StockTake       @relation(fields: [stockTakeId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  @@unique([stockTakeId, productId, variantId])
  @@map("stock_take_items")
}

// ─────────────────────────────────────────────────────────────────────────
// Audit Log (voids, refunds, stock adjustments, auth events)
// ─────────────────────────────────────────────────────────────────────────

model AuditLog {
  id         Int      @id @default(autoincrement())
  outletId   Int?     @map("outlet_id")
  userId     Int      @map("user_id")
  action     String // e.g. "VOID_TRANSACTION", "REFUND_TRANSACTION", "STOCK_ADJUSTMENT", "LOGIN_SUCCESS", "LOGIN_FAILURE", "ACCOUNT_LOCKED"
  entityType String   @map("entity_type")
  entityId   Int      @map("entity_id")
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  outlet Outlet? @relation(fields: [outletId], references: [id])
  user   User    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────
// Hardware: terminals, printers, print bridges, print job queue
// ─────────────────────────────────────────────────────────────────────────

enum CustomerDisplayMode {
  NONE
  SAME_DEVICE // second monitor on the terminal itself (BroadcastChannel)
  REMOTE // separate tablet, relayed through the backend
}

// How a print job's bytes get from the queue to the printer.
enum PrinterConnection {
  NETWORK_DIRECT // backend opens TCP to host:port itself (backend on-site)
  NETWORK_BRIDGE // an on-site print-bridge agent claims and forwards jobs
  TERMINAL_LOCAL // USB/Bluetooth printer attached to a terminal; that terminal claims jobs
}

enum PrintJobKind {
  RECEIPT
  KITCHEN_TICKET
  DRAWER_KICK
  TEST
}

enum PrintJobStatus {
  PENDING
  CLAIMED
  PRINTED
  FAILED
}

// A named POS device ("Counter 1"). The browser/app remembers which terminal
// it is in localStorage; hardware is assigned per terminal.
model Terminal {
  id                  Int                 @id @default(autoincrement())
  outletId            Int                 @map("outlet_id")
  name                String
  receiptPrinterId    Int?                @map("receipt_printer_id")
  cashDrawerEnabled   Boolean             @default(false) @map("cash_drawer_enabled")
  customerDisplayMode CustomerDisplayMode @default(NONE) @map("customer_display_mode")
  displayToken        String              @unique @map("display_token")
  lastSeenAt          DateTime?           @map("last_seen_at")
  isActive            Boolean             @default(true) @map("is_active")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  deletedAt           DateTime?           @map("deleted_at")

  outlet         Outlet        @relation(fields: [outletId], references: [id])
  receiptPrinter Printer?      @relation("TerminalReceiptPrinter", fields: [receiptPrinterId], references: [id])
  localPrinters  Printer[]     @relation("PrinterHostTerminal")
  cashSessions   CashSession[]

  @@map("terminals")
}

model Printer {
  id           Int               @id @default(autoincrement())
  outletId     Int               @map("outlet_id")
  name         String
  connection   PrinterConnection
  host         String?
  port         Int               @default(9100)
  bridgeId     Int?              @map("bridge_id")
  terminalId   Int?              @map("terminal_id") // host terminal, for TERMINAL_LOCAL
  paperWidth   Int               @default(80) @map("paper_width") // mm: 58 or 80
  charsPerLine Int               @default(48) @map("chars_per_line")
  lastStatus   String?           @map("last_status") // "OK" or the last error message
  lastSeenAt   DateTime?         @map("last_seen_at")
  isActive     Boolean           @default(true) @map("is_active")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  deletedAt    DateTime?         @map("deleted_at")

  outlet           Outlet           @relation(fields: [outletId], references: [id])
  bridge           PrintBridge?     @relation(fields: [bridgeId], references: [id])
  hostTerminal     Terminal?        @relation("PrinterHostTerminal", fields: [terminalId], references: [id])
  receiptTerminals Terminal[]       @relation("TerminalReceiptPrinter")
  kitchenStations  KitchenStation[]
  jobs             PrintJob[]

  @@map("printers")
}

// On-site agent that forwards jobs to LAN printers when the backend is hosted
// remotely. Authenticates with a token whose sha256 is stored here; the
// plaintext is shown once at creation.
model PrintBridge {
  id         Int       @id @default(autoincrement())
  outletId   Int       @map("outlet_id")
  name       String
  tokenHash  String    @unique @map("token_hash")
  lastSeenAt DateTime? @map("last_seen_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  outlet   Outlet    @relation(fields: [outletId], references: [id])
  printers Printer[]

  @@map("print_bridges")
}

// Every print (receipt, kitchen ticket, drawer kick, test page) is a row here.
// payload holds the rendered ESC/POS bytes, so every transport sends the same thing.
model PrintJob {
  id            Int            @id @default(autoincrement())
  outletId      Int            @map("outlet_id")
  printerId     Int            @map("printer_id")
  kind          PrintJobKind
  payload       Bytes
  status        PrintJobStatus @default(PENDING)
  attempts      Int            @default(0)
  lastError     String?        @map("last_error")
  transactionId Int?           @map("transaction_id")
  createdById   Int?           @map("created_by_id")
  claimedAt     DateTime?      @map("claimed_at")
  printedAt     DateTime?      @map("printed_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  outlet      Outlet       @relation(fields: [outletId], references: [id])
  printer     Printer      @relation(fields: [printerId], references: [id])
  transaction Transaction? @relation(fields: [transactionId], references: [id])
  createdBy   User?        @relation(fields: [createdById], references: [id])

  @@index([printerId, status])
  @@index([outletId, createdAt])
  @@map("print_jobs")
}
