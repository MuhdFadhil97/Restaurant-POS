generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  MANAGER
  CASHIER
  KITCHEN
}

enum MovementType {
  RESTOCK
  WASTAGE
  CORRECTION
  SALE
  REFUND
  TRANSFER_OUT
  TRANSFER_IN
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  NOT_AVAILABLE
}

enum TransactionStatus {
  HELD // parked, no table (retail "hold" flow)
  OPEN // F&B: attached to a table, still accumulating items
  COMPLETED
  VOIDED
  REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum DiscountScope {
  LINE
  ORDER
}

enum PaymentMethod {
  CASH
  CARD
  EWALLET
  GIFT_CARD
  LOYALTY_POINTS
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CustomerSource {
  WALK_IN
  SOCIAL_MEDIA
  REFERRAL
  THIRD_PARTY
  ONLINE
}

enum PrepStatus {
  QUEUED
  PREPARING
  READY
  SERVED
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum StockTransferStatus {
  PENDING
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

// ─────────────────────────────────────────────────────────────────────────
// Outlets & Users
// ─────────────────────────────────────────────────────────────────────────

model Outlet {
  id       Int     @id @default(autoincrement())
  name     String
  address  String?
  phone    String?
  isActive Boolean @default(true)

  // Receipt template settings (business name reuses `name` above).
  receiptLogoUrl String? @map("receipt_logo_url")
  receiptFooter  String? @map("receipt_footer")

  // Loyalty program settings (points earned per currency unit spent, and
  // the currency value of one point when redeemed).
  loyaltyEarnRate   Decimal @default(1) @map("loyalty_earn_rate") @db.Decimal(6, 2)
  loyaltyRedeemRate Decimal @default(0.01) @map("loyalty_redeem_rate") @db.Decimal(6, 4)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  userAccess          UserOutlet[]
  productStocks       ProductStock[]
  inventoryMovements  InventoryMovement[]
  tables              Table[]
  transactions        Transaction[]
  taxRates            TaxRate[]
  cashSessions        CashSession[]
  auditLogs           AuditLog[]
  kitchenStations     KitchenStation[]
  purchaseOrders      PurchaseOrder[]
  transfersOut        StockTransfer[]      @relation("TransferFromOutlet")
  transfersIn         StockTransfer[]      @relation("TransferToOutlet")
  staffShiftTemplates StaffShiftTemplate[]
  staffShiftSchedules StaffShiftSchedule[]
  staffAttendance     StaffAttendance[]

  @@map("outlets")
}

model User {
  id           Int     @id @default(autoincrement())
  email        String  @unique
  username     String  @unique
  passwordHash String  @map("password_hash")
  name         String
  role         Role
  isActive     Boolean @default(true) @map("is_active")

  // Login security (see [[verify-ui-by-driving-it]]-style incremental hardening).
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  outletAccess            UserOutlet[]
  cashierTransactions     Transaction[]        @relation("CashierTransactions")
  voidedTransactions      Transaction[]        @relation("VoidedByUser")
  approvedTransactions    Transaction[]        @relation("ApprovedByUser")
  inventoryMovements      InventoryMovement[]
  cashSessions            CashSession[]
  auditLogs               AuditLog[]
  purchaseOrdersCreated   PurchaseOrder[]
  stockTransfersRequested StockTransfer[]
  staffShiftSchedules     StaffShiftSchedule[] @relation("StaffShiftScheduleUser")
  createdShiftSchedules   StaffShiftSchedule[] @relation("StaffShiftScheduleCreatedBy")
  staffAttendance         StaffAttendance[]

  @@map("users")
}

// Many-to-many: which outlets a user can operate in. Cashiers usually get
// exactly one row; managers/admins may be granted several.
model UserOutlet {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  outletId  Int      @map("outlet_id")
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  outlet Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([userId, outletId])
  @@map("user_outlets")
}

// ─────────────────────────────────────────────────────────────────────────
// Product Catalog (shared across outlets) & Inventory (per outlet)
// ─────────────────────────────────────────────────────────────────────────

model ProductCategory {
  id        Int       @id @default(autoincrement())
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  products Product[]

  @@map("product_categories")
}

model Product {
  id                Int     @id @default(autoincrement())
  sku               String  @unique
  name              String
  categoryId        Int?    @map("category_id")
  unitPrice         Decimal @map("unit_price") @db.Decimal(12, 2)
  costPrice         Decimal @map("cost_price") @db.Decimal(12, 2)
  taxRateId         Int?    @map("tax_rate_id")
  unitOfMeasure     String  @map("unit_of_measure")
  imageUrl          String? @map("image_url")
  lowStockThreshold Int     @default(0) @map("low_stock_threshold")
  isActive          Boolean @default(true) @map("is_active")

  // F&B order routing: which prep station (e.g. Kitchen, Bar) makes this.
  stationId Int? @map("station_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  category ProductCategory? @relation(fields: [categoryId], references: [id])
  taxRate  TaxRate?         @relation(fields: [taxRateId], references: [id])
  station  KitchenStation?  @relation(fields: [stationId], references: [id])

  variants           ProductVariant[]
  stocks             ProductStock[]
  inventoryMovements InventoryMovement[]
  transactionItems   TransactionItem[]
  purchaseOrderItems PurchaseOrderItem[]
  stockTransferItems StockTransferItem[]
  discounts          Discount[]

  @@map("products")
}

model ProductVariant {
  id              Int       @id @default(autoincrement())
  productId       Int       @map("product_id")
  name            String // e.g. "Size", "Flavor"
  value           String // e.g. "Large", "Chocolate"
  skuSuffix       String?   @map("sku_suffix")
  priceAdjustment Decimal   @default(0) @map("price_adjustment") @db.Decimal(12, 2)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  stocks             ProductStock[]
  inventoryMovements InventoryMovement[]
  transactionItems   TransactionItem[]
  purchaseOrderItems PurchaseOrderItem[]
  stockTransferItems StockTransferItem[]

  @@map("product_variants")
}

// Current stock level per outlet (and optionally per variant).
model ProductStock {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  variantId Int?     @map("variant_id")
  outletId  Int      @map("outlet_id")
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  outlet  Outlet          @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([productId, variantId, outletId])
  @@map("product_stocks")
}

// Audit trail of every stock change, per outlet.
model InventoryMovement {
  id                Int          @id @default(autoincrement())
  outletId          Int          @map("outlet_id")
  productId         Int          @map("product_id")
  variantId         Int?         @map("variant_id")
  type              MovementType
  quantityChange    Int          @map("quantity_change") // positive = in, negative = out
  reason            String?
  performedByUserId Int          @map("performed_by_user_id")
  createdAt         DateTime     @default(now()) @map("created_at")

  outlet      Outlet          @relation(fields: [outletId], references: [id])
  product     Product         @relation(fields: [productId], references: [id])
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  performedBy User            @relation(fields: [performedByUserId], references: [id])

  @@map("inventory_movements")
}

// ─────────────────────────────────────────────────────────────────────────
// F&B Tables & Kitchen Order Routing
// ─────────────────────────────────────────────────────────────────────────

enum TableShape {
  ROUND
  RECTANGLE
}

model Table {
  id       Int         @id @default(autoincrement())
  outletId Int         @map("outlet_id")
  name     String
  capacity Int         @default(2)
  status   TableStatus @default(AVAILABLE)

  // Floor plan layout — nullable; null means "not yet positioned" (POS
  // falls back to the plain table strip until an outlet has a saved layout).
  posX   Int?        @map("pos_x")
  posY   Int?        @map("pos_y")
  shape  TableShape? @map("shape")
  width  Int?        @map("width")
  height Int?        @map("height")

  // Reservation metadata — only meaningful while status = RESERVED; all
  // four fields are cleared together whenever status changes away from
  // RESERVED (enforced in service.ts, not just the UI).
  reservedFor       String?   @map("reserved_for")
  reservedAt        DateTime? @map("reserved_at")
  reservedPartySize Int?      @map("reserved_party_size")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  outlet       Outlet        @relation(fields: [outletId], references: [id])
  transactions Transaction[]

  @@map("tables")
}

// A prep station in the kitchen/bar that a Kitchen Display screen filters
// to (e.g. "Kitchen", "Bar", "Dessert").
model KitchenStation {
  id        Int       @id @default(autoincrement())
  outletId  Int       @map("outlet_id")
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  outlet   Outlet    @relation(fields: [outletId], references: [id])
  products Product[]

  @@map("kitchen_stations")
}

// ─────────────────────────────────────────────────────────────────────────
// Customers
// ─────────────────────────────────────────────────────────────────────────

model Customer {
  id               Int             @id @default(autoincrement())
  name             String
  identificationNo String?         @map("identification_no")
  dateOfBirth      DateTime?       @map("date_of_birth") @db.Date
  phone            String?
  email            String?
  address          String?
  source           CustomerSource? @map("source")

  // Loyalty points balance, accrued/redeemed on completed transactions.
  pointsBalance Int @default(0) @map("points_balance")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  transactions Transaction[]

  @@map("customers")
}

// ─────────────────────────────────────────────────────────────────────────
// Discounts, Promotions & Tax
// ─────────────────────────────────────────────────────────────────────────

model Discount {
  id       Int           @id @default(autoincrement())
  name     String
  type     DiscountType
  scope    DiscountScope
  value    Decimal       @db.Decimal(12, 2) // percentage (0-100) or fixed amount
  code     String?       @unique
  isActive Boolean       @default(true) @map("is_active")

  // Promotion eligibility rules (all optional; null = no constraint).
  minSpend   Decimal?  @map("min_spend") @db.Decimal(12, 2)
  startDate  DateTime? @map("start_date")
  endDate    DateTime? @map("end_date")
  usageLimit Int?      @map("usage_limit")
  usageCount Int       @default(0) @map("usage_count")
  productId  Int?      @map("product_id")
  categoryId Int?      @map("category_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product? @relation(fields: [productId], references: [id])

  transactionItems TransactionItem[]
  orderDiscountOn  Transaction[]     @relation("OrderDiscount")

  @@map("discounts")
}

model TaxRate {
  id        Int      @id @default(autoincrement())
  outletId  Int      @map("outlet_id")
  name      String
  rate      Decimal  @db.Decimal(5, 2) // percentage, e.g. 6.00
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  outlet   Outlet    @relation(fields: [outletId], references: [id])
  products Product[]

  @@map("tax_rates")
}

// ─────────────────────────────────────────────────────────────────────────
// Gift Cards
// ─────────────────────────────────────────────────────────────────────────

model GiftCard {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  balance   Decimal   @db.Decimal(12, 2)
  isActive  Boolean   @default(true) @map("is_active")
  issuedAt  DateTime  @default(now()) @map("issued_at")
  expiresAt DateTime? @map("expires_at")

  payments Payment[]

  @@map("gift_cards")
}

// ─────────────────────────────────────────────────────────────────────────
// Transactions (checkout, hold/resume, F&B open tabs, void/refund)
// ─────────────────────────────────────────────────────────────────────────

model Transaction {
  id         Int               @id @default(autoincrement())
  outletId   Int               @map("outlet_id")
  tableId    Int?              @map("table_id") // set for F&B dine-in
  customerId Int?              @map("customer_id")
  cashierId  Int               @map("cashier_id")
  status     TransactionStatus @default(OPEN)

  // Assigned once, when the transaction first reaches COMPLETED. Format: RECYYYYMMDDXXXXXX.
  receiptNumber String? @unique @map("receipt_number")

  subtotal        Decimal @default(0) @db.Decimal(12, 2)
  discountTotal   Decimal @default(0) @map("discount_total") @db.Decimal(12, 2)
  orderDiscountId Int?    @map("order_discount_id")
  taxTotal        Decimal @default(0) @map("tax_total") @db.Decimal(12, 2)
  total           Decimal @default(0) @db.Decimal(12, 2)

  // Loyalty accrual/redemption recorded on the completed transaction.
  pointsEarned   Int @default(0) @map("points_earned")
  pointsRedeemed Int @default(0) @map("points_redeemed")

  notes String?

  voidReason       String?   @map("void_reason")
  voidedAt         DateTime? @map("voided_at")
  voidedByUserId   Int?      @map("voided_by_user_id")
  approvedByUserId Int?      @map("approved_by_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  outlet        Outlet    @relation(fields: [outletId], references: [id])
  table         Table?    @relation(fields: [tableId], references: [id])
  customer      Customer? @relation(fields: [customerId], references: [id])
  cashier       User      @relation("CashierTransactions", fields: [cashierId], references: [id])
  voidedBy      User?     @relation("VoidedByUser", fields: [voidedByUserId], references: [id])
  approvedBy    User?     @relation("ApprovedByUser", fields: [approvedByUserId], references: [id])
  orderDiscount Discount? @relation("OrderDiscount", fields: [orderDiscountId], references: [id])

  items    TransactionItem[]
  payments Payment[]

  @@map("transactions")
}

// Backs the atomic per-day counter used to number receipts (RECYYYYMMDDXXXXXX).
// One row per calendar day; incremented with a single UPDATE so concurrent
// checkouts serialize on the row lock instead of racing on a read-then-write.
model ReceiptSequence {
  date       String @id @db.Char(8)
  lastNumber Int    @default(0) @map("last_number")

  @@map("receipt_sequences")
}

model TransactionItem {
  id             Int     @id @default(autoincrement())
  transactionId  Int     @map("transaction_id")
  productId      Int     @map("product_id")
  variantId      Int?    @map("variant_id")
  quantity       Int
  unitPrice      Decimal @map("unit_price") @db.Decimal(12, 2)
  discountId     Int?    @map("discount_id")
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @map("tax_amount") @db.Decimal(12, 2)
  lineTotal      Decimal @map("line_total") @db.Decimal(12, 2)

  // Kitchen Display order-routing status.
  prepStatus  PrepStatus @default(QUEUED) @map("prep_status")
  preparingAt DateTime?  @map("preparing_at")
  readyAt     DateTime?  @map("ready_at")
  servedAt    DateTime?  @map("served_at")

  createdAt DateTime @default(now()) @map("created_at")

  transaction Transaction     @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product     Product         @relation(fields: [productId], references: [id])
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  discount    Discount?       @relation(fields: [discountId], references: [id])

  @@map("transaction_items")
}

model Payment {
  id            Int           @id @default(autoincrement())
  transactionId Int           @map("transaction_id")
  method        PaymentMethod
  amount        Decimal       @db.Decimal(12, 2)
  reference     String?
  remark        String?
  giftCardId    Int?          @map("gift_card_id")
  createdAt     DateTime      @default(now()) @map("created_at")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  giftCard    GiftCard?   @relation(fields: [giftCardId], references: [id])

  @@map("payments")
}

// ─────────────────────────────────────────────────────────────────────────
// Cash Sessions (shift open/close reconciliation)
// ─────────────────────────────────────────────────────────────────────────

model CashSession {
  id           Int               @id @default(autoincrement())
  outletId     Int               @map("outlet_id")
  userId       Int               @map("user_id")
  status       CashSessionStatus @default(OPEN)
  openingCash  Decimal           @map("opening_cash") @db.Decimal(12, 2)
  expectedCash Decimal?          @map("expected_cash") @db.Decimal(12, 2)
  actualCash   Decimal?          @map("actual_cash") @db.Decimal(12, 2)
  difference   Decimal?          @db.Decimal(12, 2)
  openedAt     DateTime          @default(now()) @map("opened_at")
  closedAt     DateTime?         @map("closed_at")

  outlet Outlet @relation(fields: [outletId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@map("cash_sessions")
}

enum AttendanceStatus {
  CLOCKED_IN
  ON_BREAK
  CLOCKED_OUT
}

// ─────────────────────────────────────────────────────────────────────────
// Staff Shift Management (attendance, breaks, roster — distinct from
// CashSession above, which is the till/cash-drawer "shift")
// ─────────────────────────────────────────────────────────────────────────

model StaffShiftTemplate {
  id           Int       @id @default(autoincrement())
  outletId     Int       @map("outlet_id")
  name         String
  startTime    String    @map("start_time") // "HH:mm", 24h
  endTime      String    @map("end_time") // "HH:mm"; endTime <= startTime means overnight (crosses midnight)
  breakMinutes Int       @default(30) @map("break_minutes")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at") // soft delete only — historical schedules/attendance keep resolving name/times

  outlet    Outlet               @relation(fields: [outletId], references: [id])
  schedules StaffShiftSchedule[]

  @@map("staff_shift_templates")
}

model StaffShiftSchedule {
  id              Int      @id @default(autoincrement())
  outletId        Int      @map("outlet_id")
  userId          Int      @map("user_id")
  shiftTemplateId Int      @map("shift_template_id")
  date            DateTime @map("date") @db.Date
  notes           String?
  createdByUserId Int      @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  outlet        Outlet             @relation(fields: [outletId], references: [id])
  user          User               @relation("StaffShiftScheduleUser", fields: [userId], references: [id])
  shiftTemplate StaffShiftTemplate @relation(fields: [shiftTemplateId], references: [id])
  createdBy     User               @relation("StaffShiftScheduleCreatedBy", fields: [createdByUserId], references: [id])
  attendance    StaffAttendance[]

  @@unique([userId, date, shiftTemplateId])
  @@index([outletId, date])
  @@index([userId, date])
  @@map("staff_shift_schedules")
}

model StaffAttendance {
  id                 Int              @id @default(autoincrement())
  outletId           Int              @map("outlet_id")
  userId             Int              @map("user_id")
  scheduleId         Int?             @map("schedule_id") // null = unscheduled/ad-hoc
  status             AttendanceStatus @default(CLOCKED_IN)
  clockInAt          DateTime         @map("clock_in_at")
  clockOutAt         DateTime?        @map("clock_out_at")
  totalWorkedMinutes Int?             @map("total_worked_minutes") // computed at clock-out
  totalBreakMinutes  Int?             @map("total_break_minutes") // computed at clock-out
  hasComplianceIssue Boolean          @default(false) @map("has_compliance_issue")
  complianceNotes    String?          @map("compliance_notes")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  outlet   Outlet              @relation(fields: [outletId], references: [id])
  user     User                @relation(fields: [userId], references: [id])
  schedule StaffShiftSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  breaks   StaffBreakRecord[]

  @@index([outletId, clockInAt])
  @@index([userId, clockInAt])
  @@map("staff_attendances")
}

model StaffBreakRecord {
  id           Int       @id @default(autoincrement())
  attendanceId Int       @map("attendance_id")
  breakStart   DateTime  @map("break_start")
  breakEnd     DateTime? @map("break_end")
  createdAt    DateTime  @default(now()) @map("created_at")

  attendance StaffAttendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  @@map("staff_break_records")
}

// ─────────────────────────────────────────────────────────────────────────
// Suppliers & Purchasing
// ─────────────────────────────────────────────────────────────────────────

model Supplier {
  id           Int       @id @default(autoincrement())
  name         String
  contactName  String?   @map("contact_name")
  email        String?
  phone        String?
  paymentTerms String?   @map("payment_terms")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model PurchaseOrder {
  id              Int                 @id @default(autoincrement())
  outletId        Int                 @map("outlet_id")
  supplierId      Int                 @map("supplier_id")
  status          PurchaseOrderStatus @default(DRAFT)
  createdByUserId Int                 @map("created_by_user_id")
  orderedAt       DateTime?           @map("ordered_at")
  expectedAt      DateTime?           @map("expected_at")
  receivedAt      DateTime?           @map("received_at")
  notes           String?
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  outlet    Outlet              @relation(fields: [outletId], references: [id])
  supplier  Supplier            @relation(fields: [supplierId], references: [id])
  createdBy User                @relation(fields: [createdByUserId], references: [id])
  items     PurchaseOrderItem[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               Int     @id @default(autoincrement())
  purchaseOrderId  Int     @map("purchase_order_id")
  productId        Int     @map("product_id")
  variantId        Int?    @map("variant_id")
  quantityOrdered  Int     @map("quantity_ordered")
  quantityReceived Int     @default(0) @map("quantity_received")
  unitCost         Decimal @map("unit_cost") @db.Decimal(12, 2)

  purchaseOrder PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product         @relation(fields: [productId], references: [id])
  variant       ProductVariant? @relation(fields: [variantId], references: [id])

  @@map("purchase_order_items")
}

// ─────────────────────────────────────────────────────────────────────────
// Multi-Outlet Stock Transfers
// ─────────────────────────────────────────────────────────────────────────

model StockTransfer {
  id                Int                 @id @default(autoincrement())
  fromOutletId      Int                 @map("from_outlet_id")
  toOutletId        Int                 @map("to_outlet_id")
  status            StockTransferStatus @default(PENDING)
  requestedByUserId Int                 @map("requested_by_user_id")
  sentAt            DateTime?           @map("sent_at")
  receivedAt        DateTime?           @map("received_at")
  notes             String?
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  fromOutlet  Outlet              @relation("TransferFromOutlet", fields: [fromOutletId], references: [id])
  toOutlet    Outlet              @relation("TransferToOutlet", fields: [toOutletId], references: [id])
  requestedBy User                @relation(fields: [requestedByUserId], references: [id])
  items       StockTransferItem[]

  @@map("stock_transfers")
}

model StockTransferItem {
  id              Int  @id @default(autoincrement())
  stockTransferId Int  @map("stock_transfer_id")
  productId       Int  @map("product_id")
  variantId       Int? @map("variant_id")
  quantity        Int

  stockTransfer StockTransfer   @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  product       Product         @relation(fields: [productId], references: [id])
  variant       ProductVariant? @relation(fields: [variantId], references: [id])

  @@map("stock_transfer_items")
}

// ─────────────────────────────────────────────────────────────────────────
// Audit Log (voids, refunds, stock adjustments, auth events)
// ─────────────────────────────────────────────────────────────────────────

model AuditLog {
  id         Int      @id @default(autoincrement())
  outletId   Int?     @map("outlet_id")
  userId     Int      @map("user_id")
  action     String // e.g. "VOID_TRANSACTION", "REFUND_TRANSACTION", "STOCK_ADJUSTMENT", "LOGIN_SUCCESS", "LOGIN_FAILURE", "ACCOUNT_LOCKED"
  entityType String   @map("entity_type")
  entityId   Int      @map("entity_id")
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  outlet Outlet? @relation(fields: [outletId], references: [id])
  user   User    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}
