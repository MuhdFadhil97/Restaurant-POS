# The POS backend's API base URL (same value the frontend's VITE_API_URL uses).
API_URL="https://your-pos-backend.example.com/api"

# From Settings > Hardware > Print Bridges > New Bridge. Shown once at
# creation — if lost, regenerate it from the same screen (the old one stops
# working immediately).
BRIDGE_TOKEN=""

# How often to check for new print jobs, in milliseconds.
POLL_MS=3000
